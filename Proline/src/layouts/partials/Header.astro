---
import { Image } from 'astro:assets';

import Menu from '@components/Ui/Site/Menu/Menu.vue';
import logo from '/src/assets/proline-logo.svg';

const { class: className } = Astro.props;
---

<div class="skip-wrapper leading-none">
    <a
        href="#content"
        class="sr-only top-0 block bg-black/80 text-center text-2xl font-medium text-white backdrop-blur focus:not-sr-only focus:absolute focus:w-full focus:p-8 active:not-sr-only active:absolute active:w-full active:p-8"
        id="skip-link"
    >
        Skip to main content
    </a>
</div>

<header
    class={className +
        ' bg-[#050505]/95 text-white border-b border-proline-red h-20 w-full shadow-[0_12px_40px_rgba(0,0,0,0.4)] backdrop-blur-xl'}
>
    <div
        class="mx-auto flex h-full items-center justify-between gap-10 px-5 sm:px-10"
    >
        <a href="/">
            <Image
                alt="Proline"
                loading="eager"
                class="h-14 w-auto"
                src={logo}
            />
        </a>

        <Menu client:load currentPath={Astro.url.pathname} />
    </div>
</header>

<style>
    .fixed-header {
        @apply fixed top-0 z-50;
    }
</style>
