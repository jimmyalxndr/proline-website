---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PageHeader from '@components/Ui/Components/PageHeader.vue';
import Content from '@layouts/partials/Content.astro';
import ProjectGrid from '@components/Ui/Components/ProjectGrid.vue';

const pageTitle = 'Projects';
const priorityProjects = [
    'methodist-ladies-college-aquatic-centre',
    'crowne-plaza-carlton',
    'albert-fields',
];
const completedProjects = (
    await getCollection('projects', ({ data }) => data.completed === true)
).sort((a, b) => {
    const aPriority = priorityProjects.indexOf(a.slug);
    const bPriority = priorityProjects.indexOf(b.slug);

    if (aPriority !== -1 || bPriority !== -1) {
        if (aPriority === -1) return 1;
        if (bPriority === -1) return -1;
        return aPriority - bPriority;
    }

    return b.data.order - a.data.order;
});

// const currentProjects = (
//     await getCollection('projects', ({ data }) => data.completed === false)
// ).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={pageTitle}>
    <PageHeader title={pageTitle} />
    <Content>
        <!-- {
            currentProjects.length > 0 && (
                <section class="py-20">
                    <h2 class="mb-10">Current + Upcoming Projects</h2>
                    <ProjectGrid projects={currentProjects} />
                </section>
            )
        } -->
        {
            completedProjects.length > 0 && (
                <section class="py-20">
                    <h2 class="mb-10">Completed Projects</h2>
                    <ProjectGrid projects={completedProjects} />
                </section>
            )
        }
    </Content>
</Layout>
