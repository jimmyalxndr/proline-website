---
import Layout from '@layouts/Layout.astro';
import Content from '@layouts/partials/Content.astro';

const pageTitle = 'Message Sent';
---

<Layout title={pageTitle}>
    <Content class="py-40">
        <h1
            class="mb-6 text-center text-4xl font-extralight leading-none xs:text-5xl md:text-8xl"
        >
            {pageTitle}
        </h1>

        <h2
            class="mb-10 text-center text-2xl font-bold leading-none text-fuchsia-300 xs:text-3xl md:text-5xl"
        >
            Thanks for reaching out!
        </h2>

        <p class="text-center text-xl">
            We&apos;ll get back to you as soon as we can.
        </p>
    </Content>
</Layout>
