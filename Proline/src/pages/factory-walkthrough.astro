---
import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/Ui/Components/PageHeader.vue';
import Content from '@layouts/partials/Content.astro';
import WalkthroughForm from '@components/Ui/Components/Forms/WalkthroughForm.vue';

const pageTitle = 'Enquire about a walkthrough';
const pageDescription =
    'Enquire about a walkthrough of the Proline Fabrication factory at 30 Robbins Circuit, Williamstown North. We review each enquiry and reply if a visit suits.';
---

<Layout
    title={pageTitle}
    description={pageDescription}
    image="/assets/process/manufacture.jpg"
    noindex
>
    <PageHeader title={pageTitle} compact />
    <Content>
        <section
            class="grid items-start gap-10 py-8 md:py-20 lg:grid-cols-2 lg:gap-20"
        >
            <div class="space-y-6">
                <h3>Proline Fabrication</h3>
                <h2>See how the work comes together.</h2>
                <p class="max-w-xl">
                    Send an enquiry for a walkthrough of the factory at 30
                    Robbins Circuit, Williamstown North. We review each enquiry
                    and reply if a visit suits.
                </p>
                <div class="border-l border-proline-red pl-6 text-sm">
                    <a
                        href="https://www.google.com/maps/search/?api=1&query=30+Robbins+Circuit,+Williamstown+North+VIC+3016"
                        class="block hover:text-proline-red"
                    >
                        30 Robbins Circuit, Williamstown North VIC 3016
                    </a>
                    <a
                        href="tel:+61395107257"
                        class="block hover:text-proline-red"
                    >
                        03 9510 7257
                    </a>
                </div>
            </div>

            <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
                <WalkthroughForm />
            </div>

            <div class="space-y-5 lg:col-start-1">
                <h3>If a visit suits</h3>
                <h2>A walk around the factory floor.</h2>
                <p class="max-w-xl">
                    If a visit suits, you walk the floor with us at Williamstown
                    North. The day or time on the form is a preference. We
                    review the enquiry and reply if it suits.
                </p>
            </div>
        </section>

        <section class="pb-16 md:pb-28">
            <h2 class="mb-6 max-w-lg">Inside the factory</h2>
            <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
                <figure class="sm:col-span-2">
                    <img
                        src="/assets/process/manufacture.jpg"
                        alt="Sheet metal being formed on a press on the factory floor"
                        class="aspect-[16/10] w-full object-cover"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/homepage/manufacture.jpg"
                        alt="Sheet metal folder on the factory floor"
                        class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/about-us/fabrication.jpg"
                        alt="People working at benches on the fabrication floor"
                        class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
                    />
                </figure>
            </div>
        </section>
    </Content>
</Layout>

<style>
    :global(#form-factory-walkthrough) {
        gap: 1.25rem;
    }

    :global(#form-factory-walkthrough input:not([type='hidden'])) {
        min-height: 3rem;
        font-size: 1rem;
    }

    :global(#form-factory-walkthrough button) {
        width: 100%;
    }

    @media (min-width: 640px) {
        :global(#form-factory-walkthrough button) {
            width: auto;
        }
    }

    @media (min-width: 1024px) {
        :global(#form-factory-walkthrough) {
            gap: 2rem;
        }
    }
</style>
