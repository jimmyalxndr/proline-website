---
import Layout from '@layouts/Layout.astro';
import Content from '@layouts/partials/Content.astro';
import Button from '@components/Ui/Components/Forms/Button.vue';
import WalkthroughForm from '@components/Ui/Components/Forms/WalkthroughForm.vue';

const pageTitle = 'Enquire about a walkthrough';
const pageDescription =
    'Enquire about a walkthrough of the Proline Fabrication factory at 30 Robbins Circuit, Williamstown North.';
---

<Layout
    title={pageTitle}
    description={pageDescription}
    image="/assets/process/manufacture.jpg"
    noindex
>
    <section
        id="enquiry"
        class="hero relative -mt-16 scroll-mt-24 overflow-hidden px-6 pb-8 pt-24 sm:px-10 lg:px-16 lg:pb-12 lg:pt-28 xl:px-20"
    >
        <img
            src="/assets/process/manufacture.jpg"
            alt=""
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/80"></div>
        <div
            class="relative mx-auto grid w-full max-w-screen-3xl items-start gap-5 lg:grid-cols-2 lg:items-center lg:gap-16"
        >
            <div class="max-w-xl">
                <h3 class="text-sm md:text-sm">Proline Fabrication</h3>
                <h1
                    class="mt-2 max-w-md font-khand text-4xl font-semibold leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl"
                >
                    Come through the shop.
                </h1>
                <p
                    class="mt-3 max-w-md text-sm leading-snug text-white/90 sm:text-base"
                >
                    We're in Williamstown North. Come and talk the job through
                    on the floor, with the work going on around you.
                </p>
                <p class="mt-4 text-sm leading-snug text-white">
                    <a
                        href="https://www.google.com/maps/search/?api=1&query=30+Robbins+Circuit,+Williamstown+North+VIC+3016"
                        class="underline decoration-white/30 underline-offset-4 hover:text-proline-red"
                    >
                        30 Robbins Circuit, Williamstown North VIC 3016
                    </a>
                    <br />
                    <a
                        href="tel:+61395107257"
                        class="underline decoration-white/30 underline-offset-4 hover:text-proline-red"
                    >
                        03 9510 7257
                    </a>
                </p>
            </div>
            <div class="border border-white/15 bg-black/75 p-3 sm:p-4 lg:p-5">
                <WalkthroughForm />
            </div>
        </div>
    </section>

    <Content data-no-scroll-reveal>
        <section class="py-12 md:py-20">
            <div class="max-w-xl space-y-4">
                <h2>Have a look around.</h2>
                <p>
                    The sheets are on the machines, and the people making them
                    are right there.
                </p>
            </div>
        </section>

        <section class="border-t border-white/10 py-12 md:py-20">
            <h2 class="mb-6 max-w-lg">Inside the factory</h2>
            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                <figure class="col-span-2">
                    <img
                        src="/assets/process/manufacture.jpg"
                        alt="Sheet metal being formed on a press on the factory floor"
                        loading="eager"
                        decoding="async"
                        class="aspect-[16/10] max-h-64 w-full object-cover sm:max-h-[28rem]"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/homepage/manufacture.jpg"
                        alt="Sheet metal folder on the factory floor"
                        loading="eager"
                        decoding="async"
                        class="aspect-[4/3] w-full object-cover"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/about-us/fabrication.jpg"
                        alt="People working at benches on the fabrication floor"
                        loading="eager"
                        decoding="async"
                        class="aspect-[4/3] w-full object-cover"
                    />
                </figure>
            </div>
        </section>

        <section class="border-t border-white/10 py-12 md:py-16">
            <div class="max-w-xl space-y-5">
                <h2>Got a facade job to run past us?</h2>
                <div class="[&_a]:w-full sm:[&_a]:w-auto">
                    <Button url="#enquiry" label="Ask about coming in" />
                </div>
            </div>
        </section>
    </Content>
</Layout>

<style>
    :global(#form-factory-walkthrough) {
        gap: 0.45rem;
    }

    :global(#form-factory-walkthrough label) {
        gap: 0.15rem;
    }

    :global(#form-factory-walkthrough input:not([type='hidden'])) {
        min-height: 2.25rem;
        padding-top: 0.35rem;
        padding-bottom: 0.35rem;
        font-size: 1rem;
    }

    :global(#form-factory-walkthrough button) {
        width: 100%;
        min-height: 2.75rem;
        padding-top: 0.55rem;
        padding-bottom: 0.55rem;
    }
</style>
