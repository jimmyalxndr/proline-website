---
import Layout from '@layouts/Layout.astro';
import Content from '@layouts/partials/Content.astro';
import Button from '@components/Ui/Components/Forms/Button.vue';
import WalkthroughForm from '@components/Ui/Components/Forms/WalkthroughForm.vue';

const pageTitle = 'Enquire about a walkthrough';
const pageDescription =
    'Enquire about a walkthrough of the Proline Fabrication factory at 30 Robbins Circuit, Williamstown North.';
---

<Layout
    title={pageTitle}
    description={pageDescription}
    image="/assets/process/manufacture.jpg"
    noindex
>
    <section
        class="hero relative -mt-16 flex min-h-[100svh] flex-col justify-end overflow-hidden px-6 pb-10 pt-28 sm:px-10 lg:px-16 lg:pb-16 xl:px-20"
    >
        <img
            src="/assets/process/manufacture.jpg"
            alt=""
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <div
            class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-black/45"
        >
        </div>
        <div class="relative max-w-3xl">
            <h3>Proline Fabrication</h3>
            <h1
                class="mt-3 max-w-xl font-khand text-5xl font-semibold leading-[0.95] tracking-tight text-white sm:text-6xl md:text-7xl"
            >
                See how the work comes together.
            </h1>
            <p class="mt-5 max-w-xl text-base text-white/80 sm:text-lg">
                Enquire about a walkthrough of the factory at 30 Robbins
                Circuit, Williamstown North.
            </p>
            <div class="mt-8 [&_a]:w-full sm:[&_a]:w-auto">
                <Button url="#enquiry" label="Enquire about a walkthrough" />
            </div>
        </div>
    </section>

    <Content>
        <section class="py-14 md:py-24">
            <div class="max-w-xl space-y-5">
                <h3>Why visit</h3>
                <h2>The work is made here.</h2>
                <p>
                    The factory is where fabrication is done in-house. On a
                    visit you meet the team on the floor and talk through the
                    job you have on.
                </p>
            </div>
        </section>

        <section class="border-t border-white/10 py-14 md:py-24">
            <div class="max-w-xl space-y-8">
                <div class="space-y-5">
                    <h3>What to expect</h3>
                    <h2>If a visit goes ahead.</h2>
                </div>
                <dl class="space-y-6">
                    <div class="border-l border-proline-red pl-6">
                        <dt
                            class="text-xs font-semibold uppercase tracking-[0.16em] text-proline-red"
                        >
                            Where
                        </dt>
                        <dd class="mt-2">
                            <a
                                href="https://www.google.com/maps/search/?api=1&query=30+Robbins+Circuit,+Williamstown+North+VIC+3016"
                                class="hover:text-proline-red"
                            >
                                30 Robbins Circuit, Williamstown North VIC 3016
                            </a>
                        </dd>
                    </div>
                    <div class="border-l border-proline-red pl-6">
                        <dt
                            class="text-xs font-semibold uppercase tracking-[0.16em] text-proline-red"
                        >
                            Phone
                        </dt>
                        <dd class="mt-2">
                            <a
                                href="tel:+61395107257"
                                class="hover:text-proline-red"
                            >
                                03 9510 7257
                            </a>
                        </dd>
                    </div>
                    <div class="border-l border-proline-red pl-6">
                        <dt
                            class="text-xs font-semibold uppercase tracking-[0.16em] text-proline-red"
                        >
                            How long
                        </dt>
                        <dd class="mt-2 text-proline-red">
                            [PLACEHOLDER: visit length]
                        </dd>
                    </div>
                    <div class="border-l border-proline-red pl-6">
                        <dt
                            class="text-xs font-semibold uppercase tracking-[0.16em] text-proline-red"
                        >
                            Parking
                        </dt>
                        <dd class="mt-2 text-proline-red">
                            [PLACEHOLDER: parking]
                        </dd>
                    </div>
                    <div class="border-l border-proline-red pl-6">
                        <dt
                            class="text-xs font-semibold uppercase tracking-[0.16em] text-proline-red"
                        >
                            PPE
                        </dt>
                        <dd class="mt-2 text-proline-red">
                            [PLACEHOLDER: PPE]
                        </dd>
                    </div>
                </dl>
            </div>
        </section>

        <section class="border-t border-white/10 py-14 md:py-24">
            <h2 class="mb-6 max-w-lg">Inside the factory</h2>
            <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
                <figure class="sm:col-span-2">
                    <img
                        src="/assets/process/manufacture.jpg"
                        alt="Sheet metal being formed on a press on the factory floor"
                        class="aspect-[16/10] max-h-[28rem] w-full object-cover"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/homepage/manufacture.jpg"
                        alt="Sheet metal folder on the factory floor"
                        class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
                    />
                </figure>
                <figure>
                    <img
                        src="/assets/about-us/fabrication.jpg"
                        alt="People working at benches on the fabrication floor"
                        class="aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
                    />
                </figure>
            </div>
        </section>

        <section
            id="enquiry"
            class="scroll-mt-28 border-t border-white/10 py-14 md:py-24"
        >
            <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-20">
                <div class="max-w-xl space-y-5">
                    <h3>The enquiry</h3>
                    <h2>Send it through.</h2>
                    <p>We review each enquiry and reply if a visit suits.</p>
                </div>
                <WalkthroughForm />
            </div>
        </section>

        <section class="border-t border-white/10 py-14 md:py-20">
            <div class="max-w-xl space-y-6">
                <h2>Enquire about a walkthrough.</h2>
                <div class="[&_a]:w-full sm:[&_a]:w-auto">
                    <Button
                        url="#enquiry"
                        label="Enquire about a walkthrough"
                    />
                </div>
            </div>
        </section>
    </Content>
</Layout>

<style>
    :global(#form-factory-walkthrough) {
        gap: 1.25rem;
    }

    :global(#form-factory-walkthrough input:not([type='hidden'])) {
        min-height: 3rem;
        font-size: 1rem;
    }

    :global(#form-factory-walkthrough button) {
        width: 100%;
    }

    @media (min-width: 640px) {
        :global(#form-factory-walkthrough button) {
            width: auto;
        }
    }

    @media (min-width: 1024px) {
        :global(#form-factory-walkthrough) {
            gap: 2rem;
        }
    }
</style>
